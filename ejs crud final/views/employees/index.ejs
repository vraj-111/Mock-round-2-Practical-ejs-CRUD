<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Employee List</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >
</head>

<body>

<div class="container">

    <div class="top-bar">

        <h1>Employee List</h1>

        <a
            href="/add"
            class="add-btn"
        >
            Add Employee
        </a>

    </div>

    <table>

        <thead>

            <tr>

                <th>ID</th>

                <th>Image</th>

                <th>Name</th>

                <th>E-Mail</th>

                <th>Phone</th>

                <th>Action</th>

            </tr>

        </thead>

        <tbody>

            <% if (employees.length === 0) { %>

                <tr>

                    <td
                        colspan="6"
                        class="no-data"
                    >
                        No employees found
                    </td>

                </tr>

            <% } %>


            <% employees.forEach((employee, index) => { %>

                <tr>

                    <td>
                        <%= index + 1 %>
                    </td>

                    <td>

                        <% if (employee.image) { %>

                            <img
                                src="<%= employee.image %>"
                                alt="<%= employee.name %>"
                                class="employee-image"
                            >

                        <% } else { %>

                            No Image

                        <% } %>

                    </td>

                    <td>
                        <%= employee.name %>
                    </td>

                    <td>
                        <%= employee.email %>
                    </td>

                    <td>
                        <%= employee.phone %>
                    </td>

                    <td>

                        <div class="actions">

                            <a
                                href="/edit/<%= employee.id %>"
                                class="edit-btn"
                                title="Edit"
                            >
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>

                            <a
                                href="/delete/<%= employee.id %>"
                                class="delete-btn"
                                title="Delete"
                                onclick="return confirm('Are you sure you want to delete this employee?')"
                            >
                                <i class="fa-solid fa-trash"></i>
                            </a>

                        </div>

                    </td>

                </tr>

            <% }) %>

        </tbody>

    </table>

</div>

</body>

</html>
